{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Perfil público mínimo de lector en la comunidad Folio.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "createdAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Información privada del lector aislada por privacidad.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Book": {
      "title": "Book",
      "description": "Entrada del catálogo editorial de Folio.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "publicationYear": {
          "type": "integer"
        },
        "pageCount": {
          "type": "integer"
        },
        "readingTimeMinutes": {
          "type": "integer"
        }
      },
      "required": ["id", "slug", "title", "authorId", "authorName", "genre", "publicationYear", "pageCount", "readingTimeMinutes"]
    },
    "Review": {
      "title": "Review",
      "description": "Reseña comunitaria sanitizada asociada a un libro.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "content": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200
        },
        "rating": {
          "type": "integer"
        },
        "reactionTags": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "bookId", "authorId", "authorName", "content", "rating", "reactionTags", "createdAt"]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "Progreso de lectura por usuario y libro.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "currentPage": {
          "type": "integer"
        },
        "totalPages": {
          "type": "integer"
        },
        "percentage": {
          "type": "number"
        },
        "completed": {
          "type": "boolean"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastReadAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "bookId", "currentPage", "totalPages", "percentage", "completed", "startedAt", "lastReadAt"]
    },
    "SecurityReport": {
      "title": "SecurityReport",
      "description": "Reporte de PDF corrupto, truncado o inválido detectado por el validador.",
      "type": "object",
      "properties": {
        "reporterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookId": {
          "type": "string",
          "maxLength": 128
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "errorCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reporterId", "fileName", "errorCode", "details", "createdAt"]
    }
  },
  "firestore": {
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Perfiles públicos sin PII para atribución de reseñas."
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Correos electrónicos privados accesibles únicamente por su titular."
    },
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Índice maestro de metadatos del catálogo."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reseñas editoriales comunitarias por libro."
    },
    "/reading_progress/{progressId}": {
      "schema": { "$ref": "#/entities/ReadingProgress" },
      "description": "Sincronización de progreso de lectura por usuario y libro."
    },
    "/security_reports/{reportId}": {
      "schema": { "$ref": "#/entities/SecurityReport" },
      "description": "Reportes de integridad de documentos PDF dañados."
    }
  }
}
